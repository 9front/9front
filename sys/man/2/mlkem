.TH MLKEM 2
.SH NAME
mlkem512_keypair, mlkem512_enc, mlkem512_dec,
mlkem768_keypair, mlkem768_enc, mlkem768_dec,
mlkem1024_keypair, mlkem1024_enc, mlkem1024_dec
\- Module-Latice-Based Key-Encapsulation
.SH SYNOPSIS
.B #include <u.h>
.br
.B #include <libc.h>
.br
.B #include <mp.h>
.br
.B #include <libsec.h>
.PP
.nf
.PB
int mlkem512_keypair(uchar pk[MLKEM512_publicbytes],
	uchar sk[MLKEM512_secretbytes]);
.PB
int mlkem512_enc(uchar ct[MLKEM512_cipherbytes], uchar ss[MLKEM_bytes],
	uchar pk[MLKEM512_publicbytes]);
.PB
int mlkem512_dec(uchar ss[MLKEM_bytes], uchar ct[MLKEM512_cipherbytes],
	uchar sk[MLKEM512_secretbytes]);
.PP
.PB
int mlkem768_keypair(uchar pk[MLKEM768_publicbytes],
	uchar sk[MLKEM768_secretbytes]);
.PB
int mlkem768_enc(uchar ct[MLKEM768_cipherbytes], uchar ss[MLKEM_bytes],
	uchar pk[MLKEM768_publicbytes]);
.PB
int mlkem768_dec(uchar ss[MLKEM_bytes], uchar ct[MLKEM768_cipherbytes],
	uchar sk[MLKEM768_secretbytes]);
.PP
.PB
int mlkem1024_keypair(uchar pk[MLKEM1024_publicbytes],
	uchar sk[MLKEM1024_secretbytes]);
.PB
int mlkem1024_enc(uchar ct[MLKEM1024_cipherbytes], uchar ss[MLKEM_bytes],
	uchar pk[MLKEM1024_publicbytes]);
