#!/bin/rc -e
rfork ne
. /sys/lib/git/common.rc

gitup

flagfmt='r'; args='file ...'
ifs=() eval `{aux/getflags $*} || exec aux/usage

s=A
if(~ $flagr 1)
	s=R
if(~ $#* 0)
	exec aux/usage

ifs=$nl {
	paths=`{cleanname -d $gitrel $* | drop $gitroot}
}
walk -f ./$paths | grep -v '^(./)?.git/' | \
	sed 's/^/'$s' NOQID 0 /' >> .git/INDEX9
exit ''
